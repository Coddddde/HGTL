    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python: Train Script",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--domain_A=Movies_and_TV",
                "--domain_B=CDs_and_Vinyl",
                "--domain_C=Books",
                "--train_dir=default",
                "--maxlen=100",
                "--hidden_units=50",
                "--dropout_rate=0.5",
                "--device=cuda",
                "--num_epochs=500"
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "1"
            },
            "console": "integratedTerminal"
        }
    ]
}